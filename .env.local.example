# Copie ce fichier en ".env.local" (jamais commit) et renseigne tes valeurs.

# Token de ton intégration interne Notion (Settings > Connections > Develop or manage integrations)
# Ressemble à "secret_xxx..." ou "ntn_xxx..."
NOTION_TOKEN=

# ID de la base de données Notion (dans l'URL de la base : notion.so/xxxx?v=... -> l'ID est le premier bloc de 32 caractères)
NOTION_DATABASE_ID=
